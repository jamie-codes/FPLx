# Base64url-encoded VAPID public key — safe to expose to the browser.
# Generate a key pair with: node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Base64url-encoded VAPID private key — server-only. Never use NEXT_PUBLIC_ prefix here.
VAPID_PRIVATE_KEY=

# Random secret string that gates POST /api/push/test-send to prevent abuse.
PUSH_TEST_SECRET=
